# Quartus project and DE0-Nano pin assignments for agv_top.
#
# GPIO indices use the DE0-Nano System Builder convention:
# GPIO_0[0]..GPIO_0[33] and GPIO_1[0]..GPIO_1[27].

set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE22F17C6
set_global_assignment -name TOP_LEVEL_ENTITY agv_top

set_global_assignment -name VERILOG_FILE src/agv_top.v
set_global_assignment -name VERILOG_FILE src/frame_buffer_bram.v
set_global_assignment -name VERILOG_FILE src/line_buffer_3x3.v
set_global_assignment -name VERILOG_FILE src/ov7670_capture_1.v
set_global_assignment -name VERILOG_FILE src/ov7670_sccb_config.v
set_global_assignment -name VERILOG_FILE src/stream_edge_pipeline.v
set_global_assignment -name VERILOG_FILE src/vga_display.v

set_global_assignment -name RESERVE_DATA0_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name RESERVE_DCLK_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name RESERVE_FLASH_NCE_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"

# DE0-Nano board signals.
set_location_assignment PIN_R8 -to clk50
set_location_assignment PIN_J15 -to rst_n
set_location_assignment PIN_A15 -to led_config_done
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to rst_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led_config_done

# OV7670 camera: GPIO_0[0..15].
set_location_assignment PIN_A8 -to cam_pclk
set_location_assignment PIN_B8 -to cam_href
set_location_assignment PIN_A2 -to cam_vsync
set_location_assignment PIN_A3 -to cam_d[0]
set_location_assignment PIN_B3 -to cam_d[1]
set_location_assignment PIN_B4 -to cam_d[2]
set_location_assignment PIN_A4 -to cam_d[3]
set_location_assignment PIN_B5 -to cam_d[4]
set_location_assignment PIN_A5 -to cam_d[5]
set_location_assignment PIN_D5 -to cam_d[6]
set_location_assignment PIN_B6 -to cam_d[7]
set_location_assignment PIN_A6 -to cam_xclk
set_location_assignment PIN_B7 -to cam_sioc
set_location_assignment PIN_D6 -to cam_siod
set_location_assignment PIN_A7 -to cam_reset
set_location_assignment PIN_C6 -to cam_pwdn

# VGA resistor-DAC signals: GPIO_1[0..13].
set_location_assignment PIN_F13 -to vga_hsync
set_location_assignment PIN_T15 -to vga_vsync
set_location_assignment PIN_T14 -to vga_r[0]
set_location_assignment PIN_T13 -to vga_r[1]
set_location_assignment PIN_R13 -to vga_r[2]
set_location_assignment PIN_T12 -to vga_r[3]
set_location_assignment PIN_R12 -to vga_g[0]
set_location_assignment PIN_T11 -to vga_g[1]
set_location_assignment PIN_T10 -to vga_g[2]
set_location_assignment PIN_R11 -to vga_g[3]
set_location_assignment PIN_P11 -to vga_b[0]
set_location_assignment PIN_R10 -to vga_b[1]
set_location_assignment PIN_N12 -to vga_b[2]
set_location_assignment PIN_P9 -to vga_b[3]

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cam_pclk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cam_href
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cam_vsync
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cam_d[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cam_xclk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cam_sioc
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cam_siod
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cam_reset
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cam_pwdn
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_hsync
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_vsync
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_r[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_g[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to vga_b[*]

create_clock -name clk50 -period 20.000 [get_ports {clk50}]
